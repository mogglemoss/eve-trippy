# ---- Discord --------------------------------------------------------------
# Bot token from the Developer Portal (Bot → Reset Token).
DISCORD_TOKEN=
# Application ID (General Information → Application ID).
DISCORD_CLIENT_ID=
# Server (guild) ID. Slash commands register to this guild instantly.
DISCORD_GUILD_ID=
# Channel that receives chain alerts. Leave blank to disable the watcher's posts.
DISCORD_ALERT_CHANNEL_ID=
# Channel for kill alerts (zKillboard kills in systems on the map). Blank = same as alerts.
DISCORD_KILL_CHANNEL_ID=

# ---- Opsec ----------------------------------------------------------------
# The map is corp intel. When set, only members holding one of these roles may
# use commands (comma-separated role IDs). Blank = everyone in the server.
ALLOWED_ROLE_IDS=
# When set, commands only work in these channels (comma-separated channel IDs).
ALLOWED_CHANNEL_IDS=
# Replies visible only to the caller by default (each command also has a
# `quiet` option to decide per call).
EPHEMERAL_REPLIES=off

# ---- Tripwire -------------------------------------------------------------
# Keep one copy per map (.env.dev, .env.prod) and pick one with
# ENV_FILE=.env.prod locally or `deploy.sh use prod` on the server.
TRIPWIRE_URL=https://tripwire.example.com
# A Tripwire *account* login (the username/password you type at the Tripwire
# login page), not an EVE SSO login. The API uses HTTP Basic auth.
TRIPWIRE_USERNAME=
TRIPWIRE_PASSWORD=
# Mask to read. Corp mask is <corporationID>.2; personal mask is <characterID>.1;
# custom and alliance masks are whatever Tripwire shows for them.
TRIPWIRE_MASK_ID=
# What replies call this map in footers ("Tripwire", "Tripwire dev"). The URL is never shown.
TRIPWIRE_LABEL=Tripwire

# ---- Trippy ---------------------------------------------------------------
# Comma-separated home system names. The chain is drawn outward from these.
HOME_SYSTEMS=
# How often to poll Tripwire for changes, in seconds.
POLL_SECONDS=60
# Where the watcher remembers what it has already announced.
STATE_FILE=.trippy/state.json
# Kill alerts from zKillboard's live feed: jspace (wormhole systems on the map,
# the default), all (every mapped system, k-space included), or off.
KILL_ALERTS=jspace
# Corp and alliance IDs that count as "us" (☠️ loss vs 🎯 kill). The mask's corp
# is included automatically when the mask is a corp mask (<corpID>.2).
FRIENDLY_IDS=
# How the services Trippy calls (ESI, zKillboard, EVE-Scout) can reach you if
# your bot misbehaves: an email or a URL, sent in the User-Agent. Optional.
CONTACT=

